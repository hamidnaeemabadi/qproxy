#!/usr/bin/env bats

load test_helper

setup() {
    qproxy_source_libs
    QPROXY_INSTALL_PREFIX="$BATS_TEST_TMPDIR/prefix"
}

@test "completion generation requires neither root nor proxy initialization" {
    cli_require_root() { return 1; }
    init_qproxy_config() { return 1; }
    cli_main completion bash > "$BATS_TEST_TMPDIR/qproxy.bash"
    bash -n "$BATS_TEST_TMPDIR/qproxy.bash"
    run cli_main completion fish
    [ "$status" -eq 1 ]
    [[ "$output" == *Usage:* ]]
}

@test "Bash completes commands targets proxy types and installer options" {
    qproxy_completion_generate bash > "$BATS_TEST_TMPDIR/qproxy.bash"
    source "$BATS_TEST_TMPDIR/qproxy.bash"
    COMP_WORDS=(qproxy '') COMP_CWORD=1
    _qproxy
    [[ " ${COMPREPLY[*]} " == *' completion '* ]]
    COMP_WORDS=(qproxy enable '') COMP_CWORD=2
    _qproxy
    [[ " ${COMPREPLY[*]} " == *' docker-cli '* ]]
    COMP_WORDS=(qproxy enable docker so) COMP_CWORD=3
    _qproxy
    [ "${COMPREPLY[*]}" = 'socks5h socks5' ]
    COMP_WORDS=(qproxy enable proxychains '') COMP_CWORD=3
    _qproxy
    [ "${COMPREPLY[*]}" = 'http socks5 dual' ]
    COMP_WORDS=(qproxy install --comp) COMP_CWORD=2
    _qproxy
    [ "${COMPREPLY[*]}" = --completions ]
    COMP_WORDS=(qproxy completion '') COMP_CWORD=2
    _qproxy
    [ "${COMPREPLY[*]}" = 'bash zsh install --help -h' ]
    COMP_WORDS=(qproxy disable docker '') COMP_CWORD=3
    _qproxy
    [ "${#COMPREPLY[@]}" -eq 0 ]
}

@test "Bash completes prefix directories including spaces" {
    qproxy_completion_generate bash > "$BATS_TEST_TMPDIR/qproxy.bash"
    source "$BATS_TEST_TMPDIR/qproxy.bash"
    mkdir -p "$BATS_TEST_TMPDIR/install dir"
    COMP_WORDS=(qproxy install --prefix "$BATS_TEST_TMPDIR/inst") COMP_CWORD=3
    _qproxy
    [ "${#COMPREPLY[@]}" -eq 1 ]
    [ "${COMPREPLY[0]}" = "$BATS_TEST_TMPDIR/install dir" ]
}

@test "Linux installs and removes both completions under the selected prefix" {
    detect_os() { echo linux; }
    qproxy_completion_install
    [ -f "$QPROXY_INSTALL_PREFIX/share/bash-completion/completions/qproxy" ]
    [ -f "$QPROXY_INSTALL_PREFIX/share/zsh/site-functions/_qproxy" ]
    qproxy_completion_uninstall
    [ ! -e "$QPROXY_INSTALL_PREFIX/share/bash-completion/completions/qproxy" ]
    [ ! -e "$QPROXY_INSTALL_PREFIX/share/zsh/site-functions/_qproxy" ]
}

@test "macOS completion paths use Homebrew with a prefix fallback" {
    detect_os() { echo darwin; }
    qproxy_brew_prefix() { echo "$BATS_TEST_TMPDIR/homebrew"; }
    qproxy_completion_install
    [ -f "$BATS_TEST_TMPDIR/homebrew/etc/bash_completion.d/qproxy" ]
    [ -f "$BATS_TEST_TMPDIR/homebrew/share/zsh/site-functions/_qproxy" ]
    qproxy_brew_prefix() { return 1; }
    [ "$(qproxy_completion_path bash)" = "$QPROXY_INSTALL_PREFIX/etc/bash_completion.d/qproxy" ]
}

@test "completion uninstall preserves files not generated by QProxy" {
    detect_os() { echo linux; }
    local dest
    dest=$(qproxy_completion_path bash)
    mkdir -p "$(dirname "$dest")"
    echo '# personal completion' > "$dest"
    qproxy_completion_uninstall
    [ -f "$dest" ]
}

@test "installer completions option installs scripts and uninstall removes them" {
    detect_os() { echo linux; }
    qproxy_install_copy_tree() { :; }
    qproxy_install_write_version() { :; }
    qproxy_install_link_command() { :; }
    qproxy_install --no-deps --completions --prefix "$QPROXY_INSTALL_PREFIX"
    [ -f "$QPROXY_INSTALL_PREFIX/share/bash-completion/completions/qproxy" ]
    qproxy_uninstall
    [ ! -e "$QPROXY_INSTALL_PREFIX/share/zsh/site-functions/_qproxy" ]
}

@test "Zsh completion loads through compinit and completes SOCKS5H" {
    command -v zsh >/dev/null || skip 'Zsh not installed'
    local dir="$BATS_TEST_TMPDIR/zfunc"
    mkdir -p "$dir"
    qproxy_completion_generate zsh > "$dir/_qproxy"
    zsh -n "$dir/_qproxy"
    run zsh -fc '
        fpath=("$1" $fpath)
        autoload -Uz compinit
        compinit -u -D
        [[ ${_comps[qproxy]} == _qproxy ]] || exit 1
        compadd() { print -r -- "$*"; }
        words=(qproxy enable containerd so)
        CURRENT=4
        _qproxy
    ' qproxy-test "$dir"
    [ "$status" -eq 0 ]
    [[ "$output" == *'-- http socks5h socks5'* ]]
}
